{
  "name": "dandiya-invitation",
  "version": "1.0.0",
  "description": "A beautiful Dandiya invitation",
  "scripts": {
    "dev": "npx concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mongoose": "^8.3.2",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": "22.x"
  }
}
